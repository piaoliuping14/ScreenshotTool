<Window x:Class="ScreenshotTool.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图选区" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" Cursor="Cross"
        UseLayoutRounding="True">
    <!-- P2 遮罩选区（大纲 3.2）：截图铺底（所见即所截）+ 四块遮罩挖洞 + 选区边框 + 尺寸标签 -->
    <Canvas x:Name="Root">
        <Image x:Name="BgImage" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Rectangle x:Name="MaskTop" Fill="#8C000000"/>
        <Rectangle x:Name="MaskBottom" Fill="#8C000000"/>
        <Rectangle x:Name="MaskLeft" Fill="#8C000000"/>
        <Rectangle x:Name="MaskRight" Fill="#8C000000"/>
        <Rectangle x:Name="SelBorder" Stroke="#00E5FF" StrokeThickness="1.5" Visibility="Collapsed"/>
        <Border x:Name="SizeBadge" Background="#F0202529" CornerRadius="4" Padding="9,4"
                Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12.5"/>
        </Border>
    </Canvas>
</Window>
