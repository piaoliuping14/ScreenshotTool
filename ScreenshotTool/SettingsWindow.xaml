<Window x:Class="ScreenshotTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!-- 深色主题，与主界面浮条一致 -->
    <Window.Resources>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A5257"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="#00897B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#00897B" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00695C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#004D40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background" Value="#262B2E"/>
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="BorderBrush" Value="#4A5257"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CaretBrush" Value="#ECEFF1"/>
            <Setter Property="SelectionBrush" Value="#00897B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="#2F3437" Padding="18,12" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：可拖动 + 关闭 -->
            <Grid MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                <TextBlock Text="设置" Foreground="#ECEFF1" FontWeight="SemiBold" FontSize="14"/>
                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource GhostBtn}"
                        Padding="8,2" FontSize="12" Click="OnCancelClick"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <!-- 保存位置 -->
                <TextBlock Text="截图保存位置" FontSize="12.5" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                <DockPanel Margin="0,7,0,0">
                    <Button Content="浏览..." DockPanel.Dock="Right" Margin="8,0,0,0"
                            Style="{StaticResource GhostBtn}" Click="OnBrowseClick"/>
                    <Button Content="恢复默认" DockPanel.Dock="Right"
                            Style="{StaticResource GhostBtn}" Click="OnResetClick"/>
                    <TextBox x:Name="FolderBox" Style="{StaticResource DarkBox}"/>
                </DockPanel>
                <TextBlock x:Name="HintText" FontSize="11" Foreground="#90A4AE" Margin="0,6,0,16"/>

                <!-- 快捷键 -->
                <TextBlock Text="截图快捷键" FontSize="12.5" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                <DockPanel Margin="0,7,0,0">
                    <Button x:Name="ClearHkButton" Content="清除" DockPanel.Dock="Right" Margin="8,0,0,0"
                            Style="{StaticResource GhostBtn}" Click="OnClearHkClick"/>
                    <Button x:Name="RecordButton" Content="修改" DockPanel.Dock="Right"
                            Style="{StaticResource GhostBtn}" Click="OnRecordClick"/>
                    <TextBox x:Name="HotkeyBox" Style="{StaticResource DarkBox}" Text="未设置"/>
                </DockPanel>
                <TextBlock x:Name="HkHintText" FontSize="11" Foreground="#90A4AE" Margin="0,6,0,16"
                           Text="默认不启用；点「修改」后按下组合键（如 Ctrl+Shift+A），Esc 取消"/>

                <!-- 底部按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" Width="76" Style="{StaticResource PrimaryBtn}" Click="OnOkClick"/>
                    <Button Content="取消" Width="76" Margin="8,0,0,0"
                            Style="{StaticResource GhostBtn}" Click="OnCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
